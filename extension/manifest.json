{
  "manifest_version": 3,
  "name": "AI Fast Agent Assistant",
  "version": "2.0",
  "description": "Fully autonomous ultra-fast AI browser assistant with direct CDP control.",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "cookies",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open AI Assistant"
  }
}
