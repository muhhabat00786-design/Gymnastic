{
  "manifest_version": 3,
  "name": "Ultra-Fast Chrome Automation",
  "version": "1.0",
  "description": "Zero-lag Chrome Browser Automation with hardware-level input and instant navigation",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
